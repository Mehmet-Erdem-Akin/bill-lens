rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function budgetOnlyUpdate() {
      // Kullanıcı yalnızca bütçe alanlarını değiştirebilir; alias/email sabit kalır
      return request.resource.data.email == resource.data.email
        && request.resource.data.inboundAlias == resource.data.inboundAlias
        && request.resource.data.authProvider == resource.data.authProvider;
    }

    match /users/{userId} {
      // Profil oluşturma / silme yalnızca Cloud Functions (Admin SDK)
      allow read: if isOwner(userId);
      allow create, delete: if false;
      allow update: if isOwner(userId) && budgetOnlyUpdate();

      match /connectedAccounts/{accountId} {
        allow read, write: if isOwner(userId);
      }

      // Siparişler yalnızca Functions yazar; istemci sadece kendi verisini okur
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Inbound alias haritası — yalnızca Admin SDK
    match /inboundAliases/{alias} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
