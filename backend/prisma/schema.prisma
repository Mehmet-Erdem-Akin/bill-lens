generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  apple
  email
}

enum ConnectedProvider {
  gmail
  outlook
  inbound
}

enum Platform {
  Trendyol
  Yemeksepeti
  Getir
  AmazonTR
  Hepsiburada
  Unknown
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique
  authProvider        AuthProvider        @map("auth_provider")
  inboundAlias        String              @unique @map("inbound_alias")
  monthlyBudgetLimit  Decimal             @default(0) @map("monthly_budget_limit") @db.Decimal(12, 2)
  createdAt           DateTime            @default(now()) @map("created_at")
  connectedAccounts   ConnectedAccount[]
  orders              Order[]

  @@map("users")
}

model ConnectedAccount {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  provider   ConnectedProvider
  lastSyncAt DateTime?         @map("last_sync_at")
  isActive   Boolean           @default(true) @map("is_active")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("connected_accounts")
}

model Order {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  platform        Platform
  externalOrderId String       @map("external_order_id")
  orderDate       DateTime     @map("order_date")
  subtotal        Decimal      @db.Decimal(12, 2)
  discountTotal   Decimal      @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal   Decimal      @default(0) @map("shipping_total") @db.Decimal(12, 2)
  grandTotal      Decimal      @map("grand_total") @db.Decimal(12, 2)
  currency        String       @default("TRY")
  category        String?
  items           OrderItem[]
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalOrderId])
  @@index([userId, orderDate])
  @@map("orders")
}

model OrderItem {
  id                    String  @id @default(uuid()) @db.Uuid
  orderId               String  @map("order_id") @db.Uuid
  rawProductName        String  @map("raw_product_name")
  normalizedProductName String  @map("normalized_product_name")
  quantity              Int
  unitPrice             Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice            Decimal @map("total_price") @db.Decimal(12, 2)
  order                 Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([normalizedProductName])
  @@map("order_items")
}
